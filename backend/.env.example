# AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_S3_BUCKET=cloudshare-dscc-storage-production

# AWS Credentials (Optional if running on EC2 with IAM Instance Profile or configured via 'aws configure')
# Set your actual IAM User access keys or AWS Academy temporary credentials here:
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
# AWS_SESSION_TOKEN is required only if using temporary session tokens (e.g., AWS Academy / Learner Lab)
AWS_SESSION_TOKEN=

# Authentication & JWT Secret (Change to a random secure string for production)
JWT_SECRET=cloudshare-dscc-super-secret-key-2026-romana-gauri
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Persistent SQLite Database Location
DATABASE_PATH=cloudshare.db

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
MAX_FILE_SIZE_MB=50
